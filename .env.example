# Copy this file to ".env" and fill it in. Never share .env: the token and
# secret key give full control of the bot and the accounts database.

# Discord Developer Portal → your application
DISCORD_TOKEN=            # Bot → Reset Token
DISCORD_CLIENT_ID=        # General Information → Application ID
DISCORD_GUILD_ID=         # Right-click your server → Copy Server ID (turn on Developer Mode first)

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://ecrpjbxofjijpyqimhjg.supabase.co
SUPABASE_SECRET_KEY=      # The "Secret key" (sb_secret_…), NOT the publishable one

# The buyer role, staff roles and log channel are set in Discord with
# /setup (server admins only), so they don't go here.

# Optional
WEBSITE_URL=              # e.g. https://your-site.vercel.app (adds Website / Buy buttons)
DOWNLOAD_URL=             # Where to download the app
BRAND_NAME=Custom Account Manager
